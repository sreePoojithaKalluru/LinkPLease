# Copy this to .env and fill in values for local dev
DATABASE_URL=sqlite+aiosqlite:///./linkplease.db
PSEUDOGRAM_API_URL=https://mock-api.example.com
PSEUDOGRAM_API_KEY=your-api-key-here
# The webhook HMAC secret is the same as PSEUDOGRAM_API_KEY per assignment spec.
MAX_DM_RETRIES=5
RECONCILER_INTERVAL_SECONDS=15
DM_SENDER_POLL_SECONDS=2
